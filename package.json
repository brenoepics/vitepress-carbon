{
  "name": "vitepress-carbon-monorepo",
  "private": true,
  "version": "1.6.0",
  "description": "Carbon embraces GitHub's monochromatic ethos, offering a theme for VitePress documentation that is sleek, modern, and effortlessly stylish.",
  "keywords": [
    "design-system",
    "vue"
  ],
  "homepage": "https://github.com/brenoepics/vitepress-carbon#readme",
  "bugs": {
    "url": "https://github.com/brenoepics/vitepress-carbon/issues"
  },
  "license": "MIT",
  "author": "Breno A.",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter vitepress-carbon run build && pnpm --filter vitepress-carbon-demo run dev",
    "demo-build": "vitepress build ./packages/demo",
    "storybook": "pnpm --filter vitepress-carbon-storybook run dev",
    "storybook-build": "pnpm --filter vitepress-carbon-storybook run storybook-build",
    "bump:versions": "node ./scripts/bump-versions.mjs",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "build": "pnpm --filter vitepress-carbon run build && pnpm --filter vpcar run build && pnpm --filter vitepress-carbon-demo build && pnpm storybook-build",
    "test": "vp test run",
    "test:components": "vp test run __tests__/components",
    "test:integration": "vp test run __tests__/integration",
    "prepare": "vp config",
    "contributors": "node ./scripts/fetch-contributors.mjs"
  },
  "dependencies": {
    "@algolia/client-search": "^5.56.0",
    "@types/node": "^26.1.2",
    "mark.js": "^8.11.1",
    "search-insights": "^2.17.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/mark.js": "^8.11.12",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "minisearch": "^7.2.0",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitepress": "^1.5.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.18.0"
  },
  "pnpm": {
    "comment": "Overrides for transitive dependencies (pnpm@9 reads pnpm.overrides from package.json, not from pnpm-workspace.yaml). Security patches are caret-bounded to the compatible major so parents keep resolving; the typescript pin keeps the toolchain on the declared 5.x line so autoInstallPeers can't pull the TS 7 compiler and break vue-tsc/unbuild.",
    "overrides": {
      "@xmldom/xmldom": "^0.9.10",
      "brace-expansion": "^5.0.8",
      "defu": "^6.1.5",
      "esbuild": "^0.25.0",
      "vite": "^6.4.3",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "linkify-it": "^5.0.2",
      "markdown-it": "^14.2.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss": "^8.5.18",
      "svgo": "^4.0.2",
      "typescript": "$typescript",
      "ws": "^8.21.0"
    }
  },
  "packageManager": "pnpm@9.9.0"
}
